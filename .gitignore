node_modules/
.DS_Store

# Maintainer-only notes for Claude Code (read locally, never committed)
CLAUDE.local.md

# Generated by eag when a project-scope command runs from this checkout (root only,
# so test fixtures with these names stay committable). Test in the e2e sandbox
# instead; these files can carry literal credentials.
/.mcp.json
/.agents/
/.codex/

# e2e sandboxes created inside the tree by mistake (the script refuses, this is the fallback)
/eag-sandbox*/
/sandbox*/

# `eag doctor --fix` (and every `eag setup`) creates .claude/ in whatever repo you are
# standing in; npm pack leaves a tarball behind.
/.claude/
*.tgz
