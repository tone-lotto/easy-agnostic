{
  "name": "easy-agnostic",
  "version": "0.13.0",
  "eagUpdate": {
    "protocol": 1,
    "compatibility": 1,
    "automatic": true
  },
  "description": "Easy Agnostic: scoped MCP sync, reviewed skills, project instructions and local history for Claude Code, Codex, Pi, Cursor, Antigravity and OpenCode.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "pi",
    "cursor",
    "antigravity",
    "opencode",
    "coding-agents",
    "cli",
    "sync",
    "secrets"
  ],
  "homepage": "https://github.com/tone-lotto/easy-agnostic#readme",
  "bugs": {
    "url": "https://github.com/tone-lotto/easy-agnostic/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tone-lotto/easy-agnostic.git"
  },
  "license": "MIT",
  "author": "Matheus Tonelotto",
  "type": "module",
  "bin": {
    "eag": "bin/eag.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs/history.md",
    "docs/skills.md",
    "docs/updates.md",
    "docs/agents.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "e2e": "node scripts/e2e-fixtures.mjs",
    "e2e:package": "node scripts/e2e-package.mjs",
    "e2e:live": "scripts/e2e.sh"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "^1.3.0"
  }
}
